__pycache__/

# API keys / secrets — never commit
.env
.env.*
!.env.example

# 分割エクスポートの中間物(BibTeX)。
# ACM DL は1回1,000件が上限のため出版年でスライスして複数回エクスポートするが、
# それらは Zotero 取り込み後の CSV(raw/*_wave2_*.csv)に集約済みで、
# scripts/merge_bib.py でいつでも統合し直せる。スライス別の件数・年範囲は
# docs/search_strings.md の記録表を正とする(PRISMA Item #7 の根拠はそちら)。
raw/*.bib
raw/acm2/
raw/IEEE2/

# Phase 3b の各評価者シート — **記入中は追跡しない**。
# 理由: 3人分をコミットすると互いの判定が見えてしまい、二重スクリーニングの
# 独立性が壊れる(κ が意味を失う)。
# ただし判定シートは rule.md が要求する監査証跡でもあるため、
# **スクリーニング完了後に `git add -f screening/stage1/sheet_*.csv` で必ず追跡に加える**
# (独立性はその時点で問題にならず、公開義務だけが残るため)。
# 割当表・協議リスト・最終判定は最初から追跡する。
# 2026-09-27: screening/ をフェーズ別サブフォルダへ整理したのに合わせてパスを更新。
screening/stage1/sheet_*.csv
screening/stage1/sheet_*.xlsx
# 接頭辞つきの派生シートも同じ理由で追跡しない。
screening/calibration_supplement/supplement_sheet_*.csv
screening/calibration_supplement/supplement_sheet_*.xlsx
screening/stage2/stage2_sheet_*.csv
screening/stage2/stage2_sheet_*.xlsx
# 協議ミーティング用シートも記入中は追跡しない(埋まったら consensus_worklist.csv へ転記される)。
screening/consensus/consensus_meeting*.xlsx
# 過去のバックアップ・取り込み済み提出コピーの退避先。監査証跡としてローカルには残すが追跡しない。
screening/_archive/

# Excel の一時ロックファイル(シートを開いている間だけ生成される)。
# 配布物に紛れると受け取り側が混乱するため、追跡もアーカイブもしない。
screening/~$*
~$*.xlsx

# LaTeX build artifacts (docs/ の配布資料組版)
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

# 閲覧アプリの生成物と、そこから書き出す判定 CSV。
# 判定シートと同じ理由で追跡しない（3人分が入ると互いの判定が見え独立性が壊れる）。
# HTML はコーパス全文を埋め込んだ生成物でもあるため、リポジトリには置かない。
screening/stage1/review_*.html
decisions_*.csv
screening/stage1/decisions_*.csv
# 閲覧アプリの途中保存(進捗JSON)。中身は判定そのものなので CSV と同じ理由で
# 追跡しない。フォルダは追跡したい(クローン直後に保存先として選べるように)ので、
# 中の JSON だけを除外する。
screening/stage1/json/*.json
screening/**/*.bak.xlsx

# Phase 4 の全文 PDF(著作権のある原本。追跡しない)。取得状況は fulltext/manifest.csv で管理する
fulltext/pdf/
fulltext/by_reviewer/
fulltext/inbox/
fulltext/manual/

# Phase 4 の記入中の判定シートと評価者への配布物(独立性のため追跡しない。完了後に `git add -f screening/phase4/*/phase4_sheet_*.xlsx`)
# 割当表 assignment.csv・consensus_worklist.csv・final_decisions.csv は追跡する
screening/phase4/*/phase4_sheet_*.xlsx
screening/phase4/*/phase4_sheet_*.csv
screening/phase4/*/pdf/
screening/phase4/*/review_*.html
screening/phase4/*/progress_*.json
screening/phase4/*/backup/
fulltext/txt/
fulltext/ja/
screening/phase4/*/ja_*.js
fulltext/method/
fulltext/method_ja/
screening/phase4/*/translate_requests.json
